{
  "name": "got-poll",
  "private": true,
  "type": "module",
  "version": "0.4.0",
  "author": "eb1",
  "description": "Counts anime votes from Twitch, YouTube and Rumble chat, with a live animated results page",
  "main": "electron/main.js",
  "build": {
    "appId": "com.gotpoll.app",
    "productName": "GOT Vote",
    "files": [
      "client/**/*",
      "assets/**/*",
      "build/**/*",
      "node_modules/**/*",
      "package.json",
      "electron/**/*",
      "pnpm-*.yaml"
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/better-sqlite3/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GOTPoll-${version}-win-x64-setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "GOTPoll-${version}-linux-x86_64.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": null,
      "artifactName": "GOTPoll-${version}-mac-arm64.${ext}"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "typecheck": "react-router typegen && tsc",
    "postinstall": "electron-rebuild && electron-builder install-app-deps",
    "update-shows": "pnpm build:electron && node scripts/electron-node.mjs build/electron/catalog/cli.js assets/shows.db",
    "build:electron": "tsc -p electron/tsconfig.json && node -e \"require('fs').copyFileSync('build/electron/preload.js','build/electron/preload.mjs')\"",
    "bench:matching": "pnpm build:electron && node --no-warnings scripts/bench-matching.mjs",
    "test": "pnpm build:electron && node --no-warnings --test tests/matcher.test.mjs tests/engine.test.mjs tests/supervisor.test.mjs tests/sources.test.mjs tests/downloads.test.mjs tests/tunnel.test.mjs && node scripts/electron-node.mjs --test tests/store.electron.test.mjs",
    "test:live": "pnpm build:electron && electron scripts/live-sources.mjs",
    "bench:strategies": "pnpm build:electron && node --no-warnings scripts/bench-strategies.mjs",
    "test:tunnel": "pnpm build:electron && node --no-warnings scripts/live-tunnel.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@ngrok/ngrok": "^1.7.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@react-router/node": "^7.5.3",
    "@react-router/serve": "^7.5.3",
    "@tanstack/react-table": "^8.21.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/tmi.js": "^1.8.6",
    "ag-grid-community": "^33.2.4",
    "ag-grid-react": "^33.2.4",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-is-dev": "^3.0.1",
    "express": "^5.1.0",
    "get-port": "^7.1.0",
    "http-proxy-middleware": "^3.0.5",
    "isbot": "^5.1.27",
    "lucide-react": "^0.511.0",
    "motion": "^12.23.0",
    "node-llama-cpp": "^3.22.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.3",
    "tailwind-merge": "^3.3.0",
    "tmi.js": "^1.8.5",
    "usehooks-ts": "^3.1.1",
    "ws": "^8.18.0",
    "youtube-chat": "^2.2.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.5.3",
    "@tailwindcss/vite": "^4.1.4",
    "@types/express": "^5.0.2",
    "@types/http-proxy-middleware": "^1.0.0",
    "@types/node": "^20",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.1.2",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "tailwindcss": "^4.1.4",
    "tsc-watch": "^7.1.1",
    "tw-animate-css": "^1.3.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/EbrahimTahernejad/GOTPoll.git"
  },
  "homepage": "https://github.com/EbrahimTahernejad/GOTPoll"
}
