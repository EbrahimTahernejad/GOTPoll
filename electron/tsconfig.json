{
  "compilerOptions": {
    "target": "ES2022",
    "module": "es2022",
    "outDir": "../build/electron",
    "rootDir": ".",
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./**/*"]
}
